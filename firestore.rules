rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role check: Only custom claim token.role == 'teacher', verified teacher email, or entry in trusted_teachers
    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.email in ['nmnhat.n98@gmail.com', 'admin@stem.edu.vn', 'giaovien@stem.edu.vn'] ||
        exists(/databases/$(database)/documents/trusted_teachers/$(request.auth.uid))
      );
    }

    // Users collection (Profiles)
    // Cho phép đọc thông tin công khai (tên, lớp, vai trò) trên mọi thiết bị
    // Cho phép học sinh cập nhật hồ sơ cá nhân và đổi mật khẩu
    // Giáo viên có toàn quyền quản trị
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isTeacher();
    }

    // Classes collection
    // Học sinh và giáo viên trên mọi thiết bị đều đọc được danh sách lớp học
    // Chỉ giáo viên mới có quyền tạo, sửa, xóa lớp
    match /classes/{classId} {
      allow read: if true;
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Lessons collection (Học sinh và giáo viên đọc công khai)
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Lesson Keys (Đáp án bảo mật, giải thích, bài giải & test ẩn: CHỈ GIÁO VIÊN ĐƯỢC ĐỌC/GHI)
    match /lesson_keys/{lessonId} {
      allow read, write: if isTeacher();
    }

    // Submissions collection
    // Học sinh nộp bài và xem bài làm trên máy tính, máy tính bảng, điện thoại
    // Giáo viên chấm bài, cho điểm, nhận xét
    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isTeacher();
    }

    // Trusted teachers list
    match /trusted_teachers/{userId} {
      allow read: if true;
      allow write: if isTeacher();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role check: Only custom claim token.role == 'teacher', verified teacher email, or entry in trusted_teachers
    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.email in ['nmnhat.n98@gmail.com', 'admin@stem.edu.vn', 'giaovien@stem.edu.vn'] ||
        exists(/databases/$(database)/documents/trusted_teachers/$(request.auth.uid))
      );
    }

    // Users collection (Profiles)
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only teachers can create profiles with role == 'teacher'.
      // Students can only create their own profile with role == 'student'.
      allow create: if isSignedIn() && (
        isTeacher() ||
        (request.auth.uid == userId && request.resource.data.role == 'student')
      );
      // Students cannot elevate role to teacher
      allow update: if isSignedIn() && (
        isTeacher() ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role && resource.data.role != 'teacher')
      );
      allow delete: if isTeacher();
    }

    // Classes collection
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // Lessons collection
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Students can only read their own submissions; teachers can read all
      allow read: if isSignedIn() && (
        isTeacher() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      );

      // Student submission creation: must belong to request.auth.uid, status 'submitted', score null, no teacherFeedback
      allow create: if isSignedIn() && (
        isTeacher() ||
        (
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'submitted' &&
          (!('score' in request.resource.data) || request.resource.data.score == null) &&
          (!('teacherFeedback' in request.resource.data) || request.resource.data.teacherFeedback == '')
        )
      );

      // Student update: only un-graded submissions, cannot change owner, cannot mark graded, cannot self-score
      allow update: if isSignedIn() && (
        isTeacher() ||
        (
          resource.data.studentId == request.auth.uid &&
          resource.data.status != 'graded' &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.status == 'submitted' &&
          (!('score' in request.resource.data) || request.resource.data.score == null) &&
          (!('teacherFeedback' in request.resource.data) || request.resource.data.teacherFeedback == resource.data.teacherFeedback)
        )
      );

      allow delete: if isTeacher();
    }
  }
}


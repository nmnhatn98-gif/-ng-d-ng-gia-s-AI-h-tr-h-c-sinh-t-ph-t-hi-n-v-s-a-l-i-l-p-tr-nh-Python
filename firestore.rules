rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Users collection (allows student authentication, profile updates, and batch account imports)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Classes collection
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Lessons collection (Scratch, Python, Web HTML, Robotics projects)
    match /lessons/{lessonId} {
      allow read, write: if true;
    }

    // Submissions collection (student work, automated test results, teacher grading & feedback)
    match /submissions/{submissionId} {
      allow read, write: if true;
    }
  }
}
